# Environment Variables for Render + MongoDB Deployment

# Server Configuration
PORT=10000
NODE_ENV=production
FRONTEND_URL=https://yourdomain.com
# Optional WordPress site origin allowed to call the API
WORDPRESS_URL=https://your-wordpress-site.example

# Database Configuration
USE_MONGO=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=errand_user
MYSQL_PASSWORD=errand_dev_password
MYSQL_DATABASE=errandsplace

# MongoDB is optional when USE_MONGO=false
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Authentication
JWT_SECRET=your-super-secure-jwt-secret-here-make-it-long-and-random
JWT_EXPIRY=7d

# Payment Processing
# PayPal (Sandbox for testing, change to live for production)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret

# Email Configuration (optional, for notifications)
EMAIL_FROM=noreply@yourdomain.com